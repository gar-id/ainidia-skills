{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AinidiaManifest",
  "type": "object",
  "required": ["formatVersion", "minAppVersion", "repository", "personas", "skills", "memory"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "type": "integer", "minimum": 1 },
    "minAppVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "repository": {
      "type": "object",
      "required": ["name", "description", "author", "url"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "version", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "deprecated": { "type": "boolean" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "version", "category", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "category": {
            "type": "string",
            "enum": ["CORRECTION", "CONVERSATION", "FEEDBACK", "ANALYSIS", "TOPIC", "MEMORY"]
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "requiredFor": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["MODE_1", "MODE_2", "MODE_3"] }
          },
          "deprecated": { "type": "boolean" }
        }
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "version", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  }
}
