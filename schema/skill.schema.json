{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AinidiaSkill",
  "type": "object",
  "required": ["id", "name", "version", "schema_version", "category", "system_prompt"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique URL-safe identifier, immutable once published"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "schema_version": { "type": "integer", "enum": [1] },
    "category": {
      "type": "string",
      "enum": ["CORRECTION", "CONVERSATION", "FEEDBACK", "ANALYSIS", "TOPIC", "MEMORY"]
    },
    "description": { "type": "string" },
    "system_prompt": { "type": "string", "minLength": 1 },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 100 },
        "response_delimiter": { "type": "string" }
      }
    },
    "starter_questions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
